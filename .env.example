# Generate a production value with: openssl rand -hex 32
CODEX_GATEWAY_CONFIG_SECRET=replace-with-a-stable-random-secret

# Optional source groups, scoped to the Gateway account and its host. No credentials belong here.
# See docs/model-provider-groups.md; use model names from the host's native model/list catalog.
# CODEX_GATEWAY_MODEL_GROUPS='[{"userId":1,"hostId":1,"modelProvider":"openai","displayName":"ChatGPT / auth.json","models":["gpt-6-astra"]},{"userId":1,"hostId":1,"modelProvider":"sub2api","displayName":"Sub2API","models":["gpt-6-astra"]}]'
